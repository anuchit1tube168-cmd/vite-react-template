{
  "brand": "ASTRA Read",
  "designIntent": "Warm premium serialized-fiction catalog with compact discovery density and long-reading comfort",
  "color": {
    "primary": "#315CFF",
    "primaryText": "#FFFFFF",
    "brandAccent": "#C93830",
    "gold": "#E8B83F",
    "goldSoft": "#F9E7AD",
    "background": "#F5F0E8",
    "header": "#EFE7DA",
    "surface": "#FFFAF3",
    "surfaceMuted": "#EAE1D3",
    "text": "#1F1E1D",
    "muted": "#746E65",
    "border": "#DFD4C2",
    "borderStrong": "#CFC1AA",
    "readerWhite": "#FFFFFF",
    "readerSepia": "#F5F0E8",
    "readerDark": "#171717"
