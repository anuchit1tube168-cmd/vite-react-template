  "catalog": {"desktopColumns": 6, "tabletColumns": 4, "mobileColumns": 2, "coverRatio": "3/4"},
  "motion": {"fastMs": 180, "drawerMs": 200, "reduceMotionSupported": true},
  "breakpoints": {"mobile": 560, "compact": 700, "tablet": 900, "desktop": 1120, "wide": 1280},
